# Copy to .env and fill in (never commit .env — it is gitignored)
#
# Prefer a user token to act as yourself (messages appear as you):
#   SLACK_USER_TOKEN=xoxp-...
# Bot token posts as the app instead:
#   SLACK_BOT_TOKEN=xoxb-...
#
# First non-empty of SLACK_USER_TOKEN, SLACK_TOKEN, SLACK_BOT_TOKEN wins.
# Tokens stay on the NSE host, never on the Macintosh.
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
